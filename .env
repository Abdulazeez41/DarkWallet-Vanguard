# ==============================================================================
# DarkWallet Vanguard (SecretForge) - Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# All values are read dynamically by the application. If credentials are unset
# or if endpoints are unreachable, the system gracefully engages honest simulated
# execution mode with clear, transparent labeling across the entire UI.
# ==============================================================================

# Pillar A: NEAR AI Cloud (Confidential TEE Inference - Track 03)
# Official OpenAI-compatible endpoint of NEAR AI Cloud TEE:
# https://cloud-api.near.ai/v1
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# NEAR AI Cloud API Key obtained from https://app.near.ai
NEAR_AI_API_KEY=your_near_ai_api_key_here #sk-e96496d1875240248828527c44839a98

# Model running inside NEAR AI Cloud's hardware TEE (Intel TDX / NVIDIA H100 Confidential Computing)
# Confirm active confidential model IDs in the NEAR AI model registry (e.g. deepseek-ai/DeepSeek-V3 or meta-llama/Meta-Llama-3.1-70B-Instruct)
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3

# Optional: Remote hardware attestation endorsement verification key
# If empty, the system generates an explicit developer simulated attestation proof with fresh nonce.
TEE_ATTESTATION_KEY=

# Pillar C: NEAR Intents & Agent Connect Cross-Chain Settlement (Track 04)
# Defaults to https://agentsonintents.com.
# Confirm current RPC paths and solver endpoints in the NEAR Intents documentation:
# https://docs.near-intents.org/ and https://intents.near.org/
AGENT_CONNECT_BASE_URL=https://agentsonintents.com
